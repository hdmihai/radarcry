{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hdmihai/radarcry/schema/universe.schema.json",
  "title": "CRI Radar — tabelul întregului orizont de cercetare (data/universe.json)",
  "description": "Câte un rând pentru fiecare proiect cercetat într-o rulare completă (toate proiectele eligibile din universul top 1000 + listele Alpha ale burselor) și pentru fiecare piață perpetuă din Futures Radar. Rândurile sunt tablouri sub o listă de câmpuri.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "runId", "assets", "futures"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "generatedAt": { "type": "string" },
    "runId": { "type": "string" },
    "mode": { "type": "string" },
    "note": { "type": "string" },
    "assets": { "$ref": "#/$defs/table" },
    "futures": { "$ref": "#/$defs/table" }
  },
  "$defs": {
    "table": {
      "type": "object",
      "required": ["fields", "rows"],
      "properties": {
        "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array" } }
      }
    }
  }
}
