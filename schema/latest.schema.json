{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cri-radar.local/schema/latest.schema.json",
  "title": "CRI Radar snapshot (backend → dashboard contract)",
  "description": "Singura interfață între motorul de research și dashboard. Validarea rulează la fiecare publicare: un snapshot care nu respectă contractul nu ajunge pe GitHub Pages.",
  "type": "object",
  "required": ["schemaVersion", "meta", "health", "quota", "parity", "market", "discovery", "futures", "references", "candidates", "catalysts", "alerts", "watchlist", "derivatives", "trackRecord", "stats", "methodology"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^4\\.\\d+\\.\\d+$" },
    "meta": {
      "type": "object",
      "required": ["app", "version", "generatedAt", "runId", "mode", "scope", "policy", "question", "disclaimer"],
      "properties": {
        "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
        "mode": { "enum": ["live", "fixture"] },
        "question": { "type": "string", "minLength": 20 },
        "scope": {
          "type": "object",
          "required": ["researchOnly", "automatedTrading", "tradeExecution"],
          "properties": {
            "researchOnly": { "const": true },
            "automatedTrading": { "const": false },
            "tradeExecution": { "const": false }
          }
        },
        "policy": {
          "type": "object",
          "required": ["unknownIsBearish", "subscriptionsUsed", "freeOnly"],
          "properties": {
            "unknownIsBearish": { "const": false },
            "subscriptionsUsed": { "const": false },
            "freeOnly": { "const": true }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "required": ["overall", "providers", "coverage", "universe", "labels"],
      "properties": {
        "overall": { "enum": ["HEALTHY", "DEGRADED", "CRITICAL"] },
        "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provider" } },
        "coverage": { "type": "object", "required": ["sources", "coverage", "degraded"] },
        "universe": { "type": "object", "required": ["merged", "eligible", "deep", "discovered"] },
        "labels": { "type": "object", "required": ["size"] }
      }
    },
    "quota": {
      "type": ["object", "null"],
      "required": ["providers", "paused", "pauseAtPct"],
      "properties": {
        "pauseAtPct": { "const": 95 },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/quotaProvider" } }
      }
    },
    "parity": {
      "type": "object",
      "required": ["permanent", "withKeys", "achieved", "capabilities", "gaps"],
      "properties": {
        "permanent": { "$ref": "#/$defs/score100" },
        "withKeys": { "$ref": "#/$defs/score100" },
        "achieved": { "$ref": "#/$defs/score100" },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } },
        "gaps": { "type": "array" }
      }
    },
    "market": {
      "type": "object",
      "required": ["regime", "breadth", "narratives", "altseason"],
      "properties": {
        "altseason": { "type": "object", "required": ["value", "label", "note"] }
      }
    },
    "discovery": {
      "type": "object",
      "required": ["answering", "earlyCandidates", "analysed", "rows"],
      "properties": {
        "rows": { "type": "array", "items": { "$ref": "#/$defs/discoveryRow" } }
      }
    },
    "futures": {
      "type": "object",
      "required": ["summary", "rows"],
      "properties": {
        "summary": { "type": "object", "required": ["scanned", "graded", "note"] },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/futuresRow" } }
      }
    },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "catalysts": { "type": "array", "items": { "$ref": "#/$defs/catalyst" } },
    "alerts": { "type": "object", "required": ["items", "counts"] },
    "watchlist": { "type": "object", "required": ["transitions", "alerts"] },
    "derivatives": { "type": "object", "required": ["squeezeWatch"] },
    "trackRecord": {
      "type": "object",
      "required": ["cohort", "families", "recent"],
      "properties": {
        "cohort": { "type": "object", "required": ["cohort", "horizons", "note"] }
      }
    },
    "stats": { "type": "object", "required": ["signals", "stages", "discovery"] },
    "methodology": {
      "type": "object",
      "required": ["question", "principles", "scoring", "stages", "platforms", "secrets", "labels"],
      "properties": {
        "scoring": { "type": "object", "required": ["preExpansion", "futures", "smartMoney", "earlyCandidate"] },
        "platforms": { "type": "array", "minItems": 1 },
        "secrets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/secret" } }
      }
    },
    "forecast": {
      "description": "Prognoza ≥100× / ≥20× în 12 luni: ratele de bază, modelul, lista de învățare a câștigătorilor ultimului an și cele mai mari probabilități. Opțional — snapshot-urile de dinaintea modulului nu îl au.",
      "type": "object",
      "required": ["targets", "baseRates", "model", "winners", "top", "note"],
      "properties": {
        "targets": { "type": "array", "minItems": 1, "items": { "type": "number" } },
        "baseRates": { "type": "array", "items": { "type": "object", "required": ["multiple", "pct", "lo", "hi", "events", "population"] } },
        "winners": { "type": "array", "items": { "type": "object", "required": ["symbol", "status", "statusLabel"], "properties": { "status": { "enum": ["CONFIRMED", "DOCUMENTED", "PENDING", "BELOW"] } } } },
        "top": { "type": "array", "items": { "type": "object", "required": ["key", "symbol", "targets"] } }
      }
    },
    "validity": {
      "description": "Poarta de validitate: politica, numărătorile și proiectele oprite (respinse cu motivul, în verificare cu dovada lipsă). Opțional — snapshot-urile de dinaintea porții nu îl au.",
      "type": "object",
      "required": ["policy", "checks", "summary", "rejected", "pending", "note"],
      "properties": {
        "policy": { "type": "object", "required": ["minMarketCapUsd", "maxMarketCapUsd", "maxTaxPct", "minDexLiquidityUsd", "minSpotVolumeUsd"] },
        "checks": { "type": "array", "minItems": 5, "items": { "type": "object", "required": ["key", "label", "required"] } },
        "summary": {
          "type": "object",
          "required": ["checked", "valid", "pending", "rejected", "byCode", "byCheck"],
          "properties": {
            "checked": { "type": "integer", "minimum": 0 },
            "valid": { "type": "integer", "minimum": 0 },
            "pending": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 }
          }
        },
        "rejected": { "type": "array", "items": { "$ref": "#/$defs/validityListed" } },
        "pending": { "type": "array", "items": { "$ref": "#/$defs/validityListed" } }
      }
    }
  },
  "$defs": {
    "validityStatus": { "enum": ["VALID", "PENDING", "REJECTED"] },
    "forecastView": {
      "type": ["object", "null"],
      "required": ["targets", "coverage", "nearest"],
      "properties": {
        "targets": { "type": "object" },
        "nearest": { "type": "array", "items": { "type": "object", "required": ["symbol", "multiple", "similarity"] } }
      }
    },
    "validityVerdict": {
      "type": "object",
      "required": ["status", "label", "checks", "warnings"],
      "properties": {
        "status": { "$ref": "#/$defs/validityStatus" },
        "checks": { "type": "array", "minItems": 5, "items": { "type": "object", "required": ["key", "label", "status"], "properties": { "status": { "enum": ["PASS", "WARN", "FAIL", "UNKNOWN", "NA"] } } } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validityListed": {
      "type": "object",
      "required": ["key", "symbol", "name", "status", "codes", "why"],
      "properties": {
        "status": { "enum": ["PENDING", "REJECTED"] },
        "codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "score01": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "score100": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "providerStatus": { "enum": ["OK", "PARTIAL", "NOT_CONFIGURED", "RATE_LIMITED", "TIMEOUT", "HTTP_ERROR", "NETWORK_ERROR", "INVALID_PAYLOAD", "GEO_BLOCKED", "CIRCUIT_OPEN", "BUDGET_EXHAUSTED", "QUOTA_EXHAUSTED", "SKIPPED"] },
    "provider": {
      "type": "object",
      "required": ["id", "label", "status", "plan"],
      "properties": {
        "status": { "$ref": "#/$defs/providerStatus" },
        "plan": { "type": "string", "minLength": 3 }
      }
    },
    "quotaProvider": {
      "type": "object",
      "required": ["provider", "label", "paused"],
      "properties": {
        "shareMonth": { "$ref": "#/$defs/score100" },
        "shareDay": { "$ref": "#/$defs/score100" }
      }
    },
    "capability": {
      "type": "object",
      "required": ["key", "label", "weight", "resolvedStatus", "statusLabel", "how"],
      "properties": {
        "resolvedStatus": { "enum": ["FREE_API", "FREE_DERIVED", "FREE_LINK", "OPTIONAL_KEY", "NOT_COVERED"] }
      }
    },
    "secret": {
      "type": "object",
      "required": ["env", "label", "plan", "unlocks", "signup", "configured"],
      "properties": {
        "plan": { "type": "string", "pattern": "gratuit|trial" }
      }
    },
    "reference": {
      "type": "object",
      "required": ["symbol", "name", "status", "vector", "sequence"],
      "properties": {
        "status": { "enum": ["COMPUTED", "STATIC"] },
        "vector": { "type": "object" },
        "sequence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "domain": {
      "type": "object",
      "required": ["id", "state", "score", "confidence", "weight"],
      "properties": {
        "state": { "enum": ["AVAILABLE", "UNKNOWN"] },
        "score": { "$ref": "#/$defs/score100" },
        "confidence": { "$ref": "#/$defs/score01" }
      }
    },
    "discoveryRow": {
      "type": "object",
      "required": ["key", "symbol", "name", "verdict", "thesis", "changed", "score", "risk", "market", "onchain", "platforms"],
      "properties": {
        "validity": { "$ref": "#/$defs/validityVerdict" },
        "forecast": { "$ref": "#/$defs/forecastView" },
        "verdict": {
          "type": "object",
          "required": ["answersQuestion", "earlyResearchCandidate", "stage", "stageLabel", "band", "opportunity", "momentum", "earliness", "risk", "confidence", "tests"],
          "properties": {
            "stage": { "type": "integer", "minimum": 0, "maximum": 4 },
            "band": { "enum": ["HIGH_POTENTIAL", "CONFIRMED", "EARLY", "WATCH", "IGNORE", "UNKNOWN"] },
            "opportunity": { "$ref": "#/$defs/score100" },
            "momentum": { "$ref": "#/$defs/score100" },
            "earliness": { "$ref": "#/$defs/score100" },
            "risk": { "$ref": "#/$defs/score100" },
            "confidence": { "$ref": "#/$defs/score100" },
            "tests": { "type": "array", "minItems": 3, "items": { "type": "object", "required": ["key", "label", "want", "pass"] } }
          }
        },
        "thesis": {
          "type": "object",
          "required": ["headline", "paragraph", "timing", "confirms", "questionAnswer"],
          "properties": {
            "paragraph": { "type": "string", "minLength": 40 },
            "questionAnswer": { "type": "object", "required": ["question", "small", "simultaneous", "notYetObvious", "risksThatInvalidate", "verdict"] }
          }
        },
        "changed": {
          "type": "object",
          "required": ["count", "familyCount", "families", "confluence", "simultaneous", "obviousness", "earliness", "summary", "changes"],
          "properties": {
            "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }
          }
        },
        "score": {
          "type": "object",
          "required": ["value", "band", "confidence", "coverage", "factors", "missing"],
          "properties": {
            "value": { "$ref": "#/$defs/score100" },
            "confidence": { "$ref": "#/$defs/score100" },
            "factors": { "type": "array", "items": { "$ref": "#/$defs/factor" } },
            "missing": { "type": "array" }
          }
        },
        "risk": {
          "type": "object",
          "required": ["score", "level", "counts", "invalidators", "note"],
          "properties": {
            "score": { "$ref": "#/$defs/score100" },
            "level": { "enum": ["CRITIC", "RIDICAT", "MODERAT", "SCĂZUT", "MINIM"] },
            "invalidators": { "type": "array", "items": { "$ref": "#/$defs/invalidator" } }
          }
        },
        "platforms": { "type": "array", "items": { "$ref": "#/$defs/platformLink" } }
      }
    },
    "change": {
      "type": "object",
      "required": ["key", "family", "label", "weight", "magnitude", "detail"],
      "properties": {
        "family": { "enum": ["FLOW", "HOLDERS", "LIQUIDITY", "DERIVATIVES", "FUNDAMENTALS", "ATTENTION", "LISTING", "STRUCTURE"] }
      }
    },
    "factor": {
      "type": "object",
      "required": ["key", "label", "weight", "effectiveWeight", "score", "points", "quality"],
      "properties": {
        "score": { "$ref": "#/$defs/score100" },
        "quality": { "enum": ["HIGH", "MEDIUM", "LOW", "STALE", "UNKNOWN"] }
      }
    },
    "invalidator": {
      "type": "object",
      "required": ["key", "category", "severity", "label", "invalidates", "watch"],
      "properties": {
        "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "invalidates": { "type": "string", "minLength": 5 },
        "watch": { "type": "string", "minLength": 3 }
      }
    },
    "platformLink": {
      "type": "object",
      "required": ["key", "label", "group", "layer", "layerLabel", "role", "plan", "url"],
      "properties": {
        "layer": { "enum": ["AUTO", "LINK", "KEY_SLOT"] },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "futuresRow": {
      "type": "object",
      "required": ["key", "symbol", "grade", "positioning", "liquidity", "volume"],
      "properties": {
        "grade": {
          "type": "object",
          "required": ["grade", "score", "confidence", "verdict", "caps", "blocked", "blocks"],
          "properties": {
            "grade": { "enum": ["A++", "A+", "A", "B", "NO_TRADE"] },
            "score": { "$ref": "#/$defs/score100" }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["key", "symbol", "name", "depth", "market", "score", "stage", "hype", "signal", "analogs", "domains", "risk", "whyNow", "missing"],
      "properties": {
        "validity": { "$ref": "#/$defs/validityVerdict" },
        "forecast": { "$ref": "#/$defs/forecastView" },
        "depth": { "enum": ["deep", "light"] },
        "score": {
          "type": "object",
          "required": ["cri", "tier", "confidence", "coverage", "reliability", "state"],
          "properties": {
            "cri": { "$ref": "#/$defs/score100" },
            "tier": { "enum": ["A", "B", "C", "D", "E"] },
            "confidence": { "$ref": "#/$defs/score01" },
            "coverage": { "$ref": "#/$defs/score01" },
            "reliability": { "$ref": "#/$defs/score01" },
            "state": { "enum": ["STRONGLY_POSITIVE", "POSITIVE", "SLIGHTLY_POSITIVE", "NEUTRAL", "SLIGHTLY_NEGATIVE", "NEGATIVE", "STRONGLY_NEGATIVE", "UNRESOLVED", "INSUFFICIENT_DATA"] }
          }
        },
        "stage": { "enum": ["DECLINE", "BASE", "BUILDING", "ACCELERATION", "PRE_EXPANSION", "EXPANSION", "POST_EXPANSION", "UNKNOWN"] },
        "hype": { "enum": ["STEALTH", "EMERGING", "HYPED", "EXHAUSTED", "UNKNOWN"] },
        "signal": {
          "type": "object",
          "required": ["type", "label", "reasons", "blockers"],
          "properties": { "type": { "enum": ["BUY_SETUP", "ACCUMULATE", "WATCH", "LATE", "AVOID", "NONE"] } }
        },
        "domains": { "type": "array", "items": { "$ref": "#/$defs/domain" } },
        "risk": {
          "type": "object",
          "required": ["score", "grade", "critical", "flags"],
          "properties": { "grade": { "enum": ["A", "B", "C", "D"] }, "score": { "$ref": "#/$defs/score100" } }
        }
      }
    },
    "catalyst": {
      "type": "object",
      "required": ["id", "type", "assetKey", "symbol", "title", "polarity", "confidence", "observedAt", "source"],
      "properties": {
        "polarity": { "enum": ["POSITIVE", "NEGATIVE", "NEUTRAL", "UNKNOWN"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
