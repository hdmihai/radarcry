{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cri-radar.local/schema/agent.schema.json",
  "title": "CRI Radar — raportul agentului AI de calitate (data/agent.json)",
  "description": "Publicat de agent/main.js pe ramura cri-agent și copiat de scanare și puls în site. Contractul dintre agent și ecranul „Agent AI”.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "mode", "overall", "summary", "groups", "gates", "findings", "cadence", "efficiency", "norms", "calibration", "identification", "rules", "selfEval", "learning", "plan", "narrative", "history", "policy"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^1\\." },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "mode": { "enum": ["live", "demo"] },
    "repo": { "type": ["string", "null"] },
    "overall": { "$ref": "#/$defs/status" },
    "summary": {
      "type": "object",
      "required": ["overall", "counts", "total"],
      "properties": {
        "overall": { "$ref": "#/$defs/status" },
        "total": { "type": "integer", "minimum": 1 },
        "counts": {
          "type": "object",
          "required": ["PASS", "WARN", "FAIL", "UNKNOWN", "LEARNING"],
          "properties": {
            "PASS": { "type": "integer", "minimum": 0 },
            "WARN": { "type": "integer", "minimum": 0 },
            "FAIL": { "type": "integer", "minimum": 0 },
            "UNKNOWN": { "type": "integer", "minimum": 0 },
            "LEARNING": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "groups": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "label", "counts"] } },
    "gates": { "type": "array", "minItems": 33, "items": { "$ref": "#/$defs/gate" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "cadence": { "type": "array", "items": { "type": "object", "required": ["workflow", "name", "runs", "perDay"] } },
    "efficiency": {
      "type": "object",
      "required": ["capability", "freshness", "reliability", "effective", "design", "levers", "note"],
      "properties": {
        "capability": { "type": ["object", "null"] },
        "freshness": { "type": "object", "required": ["promised", "observed"] },
        "reliability": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "effective": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "design": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "levers": { "type": "array" },
        "note": { "type": "string" }
      }
    },
    "norms": { "type": "array", "items": { "type": "object", "required": ["metric", "label", "n", "status"], "properties": { "status": { "enum": ["LEARNING", "NORMAL", "ANOMALY"] } } } },
    "calibration": { "type": "object", "required": ["cohorts", "predictions", "interim"] },
    "identification": {
      "description": "Eficiența identificării pe istoricul propriu al radarului (cri-state/discovery.json); null când istoricul nu este disponibil.",
      "type": ["object", "null"],
      "properties": {
        "short": { "$ref": "#/$defs/idWindow" },
        "medium": { "$ref": "#/$defs/idWindow" },
        "source": { "type": "string" }
      }
    },
    "rules": {
      "description": "Regulile fundamentale (agent/knowledge/rules.json), încărcate în memorie și evaluate la fiecare rulare.",
      "type": "object",
      "required": ["version", "hash", "counts", "total", "results", "recommendations"],
      "properties": {
        "version": { "type": ["string", "null"] },
        "hash": { "type": ["string", "null"] },
        "total": { "type": "integer", "minimum": 0 },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "area", "title", "rule", "status", "evidence"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Z]+-\\d+$" },
              "area": { "enum": ["principiu", "identificare", "prognoză", "monitorizare"] },
              "status": { "$ref": "#/$defs/status" },
              "value": { "type": ["string", "null"] },
              "evidence": { "type": "string" },
              "recommendation": { "type": ["string", "null"] }
            }
          }
        },
        "recommendations": { "type": "array", "items": { "type": "object", "required": ["id", "text"] } }
      }
    },
    "selfEval": {
      "description": "Auto-evaluarea: predicțiile agentului pentru rularea următoare, notate Brier față de regula naivă și de frecvența simplă.",
      "type": "object",
      "required": ["runsScored", "predictions", "minRuns", "ready", "brier", "skill", "curve", "coverage"],
      "properties": {
        "runsScored": { "type": "integer", "minimum": 0 },
        "predictions": { "type": "integer", "minimum": 0 },
        "ready": { "type": "boolean" },
        "brier": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "brierPersistence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "brierClimatology": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "skill": { "type": ["number", "null"] },
        "curve": { "type": "array" },
        "coverage": { "type": "object", "required": ["n", "insidePct", "targetPct"] },
        "coder": { "type": ["object", "null"] }
      }
    },
    "incidents": { "type": "object", "required": ["open", "resolved"] },
    "learning": { "type": "object", "required": ["runs", "since", "metrics", "normsLearned", "incidents", "fixes"] },
    "plan": { "type": "object", "required": ["actions", "skipped"] },
    "actions": { "type": "array" },
    "narrative": {
      "type": ["object", "null"],
      "properties": { "by": { "enum": ["llm", "template"] }, "text": { "type": "string" } }
    },
    "history": { "type": "array", "items": { "type": "object", "required": ["at", "overall"] } },
    "policy": { "type": "object", "required": ["freeOnly", "researchOnly"], "properties": { "freeOnly": { "const": true }, "researchOnly": { "const": true } } }
  },
  "$defs": {
    "status": { "enum": ["PASS", "WARN", "FAIL", "UNKNOWN", "LEARNING"] },
    "idWindow": {
      "type": "object",
      "required": ["horizonH", "thresholdPct", "observations", "scans", "movers", "baseRatePct", "tiers"],
      "properties": {
        "horizonH": { "type": "number", "exclusiveMinimum": 0 },
        "thresholdPct": { "type": "number", "exclusiveMinimum": 0 },
        "observations": { "type": "integer", "minimum": 0 },
        "baseRatePct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "n", "hits", "ratePct", "lift", "ready"],
            "properties": {
              "n": { "type": "integer", "minimum": 0 },
              "hits": { "type": "integer", "minimum": 0 },
              "ratePct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "lift": { "type": ["number", "null"], "minimum": 0 },
              "ready": { "type": "boolean" }
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": ["id", "group", "title", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z.]+$" },
        "group": { "enum": ["cod", "rulare", "cadenta", "periodic", "model", "agent"] },
        "title": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "severity": { "enum": ["critical", "serious", "warning", null] },
        "value": { "type": ["string", "null"] },
        "evidence": { "type": "string" },
        "remedy": { "type": ["string", "null"] },
        "link": { "type": ["string", "null"] }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "title", "status", "severity", "evidence"],
      "properties": {
        "status": { "enum": ["WARN", "FAIL"] },
        "severity": { "enum": ["critical", "serious", "warning", "info"] }
      }
    }
  }
}
